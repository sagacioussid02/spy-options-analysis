<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sidd.spy.reflection</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/siddharthshankar/workspace/spy/cma_lab/run_reflection.sh</string>
    </array>

    <!-- Weekly: Friday (Weekday 5) at 16:30 LOCAL, after the 4pm ET close. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>5</integer>
        <key>Hour</key><integer>16</integer>
        <key>Minute</key><integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/siddharthshankar/workspace/spy/cma_lab/briefings/reflection.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/siddharthshankar/workspace/spy/cma_lab/briefings/reflection.err.log</string>
</dict>
</plist>
